{
  "version": "1.0.8",
  "layout_name": "admin_realtime_vm",
  "permissions": ["moabom-system.realtime.read"],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:moabom-system.admin.realtime_vm.title",
    "description": "$t:moabom-system.admin.realtime_vm.description"
  },
  "transition_overlay": {
    "target": "realtime_vm_content",
    "fallback_target": "right_content_area",
    "wait_for": ["realtimeStatus", "vmMetricsLive"]
  },
  "computed": {
    "overallOk": "{{!!realtimeStatus?.data?.overall_ok}}",
    "checkedAt": "{{realtimeStatus?.data?.checked_at || ''}}",
    "wsHttpStatus": "{{realtimeStatus?.data?.websocket_probe?.http_status ?? '—'}}",
    "wsUpgradeOk": "{{!!(realtimeStatus?.data?.websocket_probe?.upgrade_ok ?? (realtimeStatus?.data?.websocket_probe?.http_status === 101))}}",
    "wsConnectMs": "{{typeof realtimeStatus?.data?.websocket_probe?.connect_ms === 'number' ? realtimeStatus.data.websocket_probe.connect_ms + ' ms' : (typeof realtimeStatus?.data?.websocket_probe?.latency_ms === 'number' ? realtimeStatus.data.websocket_probe.latency_ms + ' ms' : '—')}}",
    "wsProbeNote": "{{realtimeStatus?.data?.websocket_probe?.note === 'server_upgrade_ok_browser_wss_ssot' ? '$t:moabom-system.admin.realtime_vm.probe_note_upgrade_ok' : ''}}",
    "wsHost": "{{realtimeStatus?.data?.websocket_probe?.host || '—'}}",
    "wsError": "{{realtimeStatus?.data?.websocket_probe?.error || ''}}",
    "clientEndpoint": "{{(realtimeStatus?.data?.config?.client_scheme || 'https') + '://' + (realtimeStatus?.data?.config?.client_host || '—') + ':' + (realtimeStatus?.data?.config?.client_port || '')}}",
    "serverPublishUrl": "{{realtimeStatus?.data?.config?.server_publish_url || '—'}}",
    "broadcastConnection": "{{realtimeStatus?.data?.config?.broadcast_connection || '—'}}",
    "broadcastImmediate": "{{realtimeStatus?.data?.config?.broadcast_immediate ? 'ShouldBroadcastNow' : '—'}}",
    "archVm": "{{realtimeStatus?.data?.architecture?.vm_name || '—'}}",
    "archDns": "{{realtimeStatus?.data?.architecture?.dns_host || '—'}}",
    "archPublicIp": "{{realtimeStatus?.data?.architecture?.vm_public_ip || '—'}}",
    "archInternalIp": "{{realtimeStatus?.data?.architecture?.vm_internal_ip || '—'}}",
    "vmMetricsAvailable": "{{!!(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.available : realtimeStatus?.data?.vm_metrics?.available)}}",
    "vmMetricsReason": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.reason : realtimeStatus?.data?.vm_metrics?.reason) || ''}}",
    "metricsGeneratedAt": "{{(vmMetricsLive?.data?.available !== undefined ? (vmMetricsLive.data?.data?.generated_at || vmMetricsLive.data?.fetched_at) : (realtimeStatus?.data?.vm_metrics?.data?.generated_at || realtimeStatus?.data?.vm_metrics?.fetched_at)) || ''}}",
    "cpuPct": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.cpu_percent : realtimeStatus?.data?.vm_metrics?.data?.cpu_percent) ?? 0}}",
    "memPct": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.memory_percent : realtimeStatus?.data?.vm_metrics?.data?.memory_percent) ?? 0}}",
    "diskPct": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.disk_percent : realtimeStatus?.data?.vm_metrics?.data?.disk_percent) ?? 0}}",
    "loadAvg": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.load_avg : realtimeStatus?.data?.vm_metrics?.data?.load_avg) || '—'}}",
    "uptimeHours": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.uptime_seconds : realtimeStatus?.data?.vm_metrics?.data?.uptime_seconds) ? Math.floor((vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.uptime_seconds : realtimeStatus?.data?.vm_metrics?.data?.uptime_seconds) / 3600) + 'h' : '—'}}",
    "redisClients": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.redis?.connected_clients : realtimeStatus?.data?.vm_metrics?.data?.redis?.connected_clients) ?? '—'}}",
    "redisMemory": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.redis?.used_memory_human : realtimeStatus?.data?.vm_metrics?.data?.redis?.used_memory_human) || '—'}}",
    "procNginx": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.processes?.nginx : realtimeStatus?.data?.vm_metrics?.data?.processes?.nginx) ? 'OK' : 'DOWN'}}",
    "procReverb": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.processes?.reverb : realtimeStatus?.data?.vm_metrics?.data?.processes?.reverb) ? 'OK' : 'DOWN'}}",
    "procRedis": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.processes?.redis : realtimeStatus?.data?.vm_metrics?.data?.processes?.redis) ? 'OK' : 'DOWN'}}",
    "svcReverbMode": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.services?.reverb?.mode : realtimeStatus?.data?.vm_metrics?.data?.services?.reverb?.mode) || '—'}}",
    "svcRedisMode": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.services?.redis?.mode : realtimeStatus?.data?.vm_metrics?.data?.services?.redis?.mode) || '—'}}",
    "svcReverbName": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.services?.reverb?.name : realtimeStatus?.data?.vm_metrics?.data?.services?.reverb?.name) || ''}}",
    "svcRedisName": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.services?.redis?.name : realtimeStatus?.data?.vm_metrics?.data?.services?.redis?.name) || ''}}",
    "svcReverbText": "{{_computed.procReverb + ' · ' + (_computed.svcReverbMode === 'docker' ? '$t:moabom-system.admin.realtime_vm.service_mode_docker' : (_computed.svcReverbMode === 'native' ? '$t:moabom-system.admin.realtime_vm.service_mode_native' : _computed.svcReverbMode)) + (_computed.svcReverbName ? ' · ' + _computed.svcReverbName : '')}}",
    "svcRedisText": "{{_computed.procRedis + ' · ' + (_computed.svcRedisMode === 'docker' ? '$t:moabom-system.admin.realtime_vm.service_mode_docker' : (_computed.svcRedisMode === 'native' ? '$t:moabom-system.admin.realtime_vm.service_mode_native' : _computed.svcRedisMode)) + (_computed.svcRedisName ? ' · ' + _computed.svcRedisName : '')}}",
    "showDockerStats": "{{_computed.vmMetricsAvailable && ((vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.reverb?.running : realtimeStatus?.data?.vm_metrics?.data?.containers?.reverb?.running) || (vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.redis?.running : realtimeStatus?.data?.vm_metrics?.data?.containers?.redis?.running))}}",
    "containerReverbText": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.reverb?.running : realtimeStatus?.data?.vm_metrics?.data?.containers?.reverb?.running) ? ('CPU ' + ((vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.reverb?.cpu : realtimeStatus?.data?.vm_metrics?.data?.containers?.reverb?.cpu) || '—') + ' · Mem ' + ((vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.reverb?.memory : realtimeStatus?.data?.vm_metrics?.data?.containers?.reverb?.memory) || '—')) : '—'}}",
    "containerRedisText": "{{(vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.redis?.running : realtimeStatus?.data?.vm_metrics?.data?.containers?.redis?.running) ? ('CPU ' + ((vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.redis?.cpu : realtimeStatus?.data?.vm_metrics?.data?.containers?.redis?.cpu) || '—') + ' · Mem ' + ((vmMetricsLive?.data?.available !== undefined ? vmMetricsLive.data?.data?.containers?.redis?.memory : realtimeStatus?.data?.vm_metrics?.data?.containers?.redis?.memory) || '—')) : '—'}}",
    "hasError": "{{!!_dataSourceErrors?.realtimeStatus}}"
  },
  "data_sources": [
    {
      "id": "realtimeStatus",
      "type": "api",
      "endpoint": "/api/modules/moabom-system/platform/realtime-vm",
      "method": "GET",
      "loading_strategy": "blocking",
      "auto_fetch": true,
      "auth_required": true,
      "errorHandling": {
        "401": {
          "handler": "showErrorPage",
          "params": {
            "target": "content",
            "message": "$t:moabom-system.admin.realtime_vm.auth_required"
          }
        },
        "403": {
          "handler": "showErrorPage",
          "params": {
            "target": "content",
            "message": "$t:moabom-system.admin.realtime_vm.permission_denied"
          }
        },
        "404": {
          "handler": "showErrorPage",
          "params": {
            "target": "content",
            "message": "$t:moabom-system.admin.realtime_vm.platform_only"
          }
        }
      }
    },
    {
      "id": "vmMetricsLive",
      "type": "api",
      "endpoint": "/api/modules/moabom-system/platform/realtime-vm/metrics",
      "method": "GET",
      "loading_strategy": "blocking",
      "auto_fetch": true,
      "auth_required": true
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "id": "realtime_vm_content",
          "className": "p-4 sm:p-6 lg:p-8 bg-gray-50 dark:bg-gray-900 min-h-screen"
        },
        "children": [
          {
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:moabom-system.admin.realtime_vm.title",
              "description": "$t:moabom-system.admin.realtime_vm.description"
            },
            "children": [
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "title": "$t:moabom-system.admin.realtime_vm.refresh",
                  "className": "p-2 mr-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/moabom-system/platform/realtime-vm/refresh",
                    "params": {
                      "method": "POST"
                    },
                    "onSuccess": [
                      {
                        "handler": "parallel",
                        "actions": [
                          {
                            "handler": "refetchDataSource",
                            "params": { "dataSourceId": "realtimeStatus" }
                          },
                          {
                            "handler": "refetchDataSource",
                            "params": { "dataSourceId": "vmMetricsLive" }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": { "name": "refresh", "className": "w-5 h-5" }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mt-6 grid grid-cols-1 lg:grid-cols-3 gap-4"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 shadow-sm"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H3",
                    "props": { "className": "text-sm font-semibold text-gray-900 dark:text-white mb-3" },
                    "text": "$t:moabom-system.admin.realtime_vm.card_overall"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "{{_computed.overallOk ? 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300' : 'inline-flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300'}}"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{_computed.overallOk ? '$t:moabom-system.admin.realtime_vm.status_ok' : '$t:moabom-system.admin.realtime_vm.status_fail'}}"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": { "className": "mt-3 text-xs text-gray-500 dark:text-gray-400" },
                    "text": "{{'$t:moabom-system.admin.realtime_vm.checked_at' + ': ' + (_computed.checkedAt || '—')}}"
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 shadow-sm"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H3",
                    "props": { "className": "text-sm font-semibold text-gray-900 dark:text-white mb-3" },
                    "text": "$t:moabom-system.admin.realtime_vm.card_websocket"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "space-y-2 text-sm" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "flex justify-between gap-4 text-gray-900 dark:text-gray-100" },
                        "text": "{{'HTTP · ' + _computed.wsHttpStatus}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "flex justify-between gap-4 text-gray-900 dark:text-gray-100" },
                        "text": "{{'$t:moabom-system.admin.realtime_vm.probe_upgrade' + ' · ' + (_computed.wsUpgradeOk ? 'OK (101)' : 'FAIL')}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "flex justify-between gap-4 text-gray-900 dark:text-gray-100" },
                        "text": "{{'$t:moabom-system.admin.realtime_vm.probe_connect' + ' · ' + _computed.wsConnectMs}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{!!_computed.wsProbeNote}}",
                        "props": { "className": "text-xs text-gray-500 dark:text-gray-400 leading-relaxed" },
                        "text": "{{_computed.wsProbeNote}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "flex justify-between gap-4 text-gray-900 dark:text-gray-100" },
                        "text": "{{'Host · ' + _computed.wsHost}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{!!_computed.wsError}}",
                        "props": { "className": "flex justify-between gap-4 text-red-600 dark:text-red-400 text-xs break-all" },
                        "text": "{{'Error · ' + _computed.wsError}}"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 shadow-sm"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H3",
                    "props": { "className": "text-sm font-semibold text-gray-900 dark:text-white mb-3" },
                    "text": "$t:moabom-system.admin.realtime_vm.card_runtime"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "space-y-2 text-sm" },
                    "children": [
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "text-xs font-mono text-gray-900 dark:text-gray-100 break-all" },
                        "text": "{{'$t:moabom-system.admin.realtime_vm.client_endpoint' + ' · ' + _computed.clientEndpoint}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "text-xs font-mono text-gray-900 dark:text-gray-100 break-all" },
                        "text": "{{'$t:moabom-system.admin.realtime_vm.server_publish' + ' · ' + _computed.serverPublishUrl}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "font-mono text-gray-900 dark:text-gray-100" },
                        "text": "{{'Broadcast · ' + _computed.broadcastConnection}}"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": { "className": "font-mono text-gray-900 dark:text-gray-100" },
                        "text": "{{'$t:moabom-system.admin.realtime_vm.immediate' + ' · ' + _computed.broadcastImmediate}}"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mt-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 shadow-sm"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex flex-wrap items-center justify-between gap-2 mb-4" },
                "children": [
                  {
                    "type": "basic",
                    "name": "H3",
                    "props": { "className": "text-sm font-semibold text-gray-900 dark:text-white" },
                    "text": "$t:moabom-system.admin.realtime_vm.card_vm_metrics"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "if": "{{_computed.vmMetricsAvailable}}",
                    "props": { "className": "text-xs text-gray-500 dark:text-gray-400" },
                    "text": "{{'$t:moabom-system.admin.realtime_vm.metrics_at' + ': ' + (_computed.metricsGeneratedAt || '—')}}"
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_computed.vmMetricsAvailable}}",
                "props": { "className": "grid grid-cols-1 md:grid-cols-3 gap-6" },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "flex justify-between items-center mb-2" },
                        "children": [
                          { "type": "basic", "name": "Span", "props": { "className": "text-sm font-medium text-gray-700 dark:text-gray-300" }, "text": "CPU" },
                          { "type": "basic", "name": "Span", "props": { "className": "text-sm font-medium text-gray-700 dark:text-gray-300" }, "text": "{{_computed.cpuPct}}%" }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2" },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "bg-blue-500 h-2 rounded-full",
                              "style": { "width": "{{_computed.cpuPct}}%" }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "flex justify-between items-center mb-2" },
                        "children": [
                          { "type": "basic", "name": "Span", "props": { "className": "text-sm font-medium text-gray-700 dark:text-gray-300" }, "text": "Memory" },
                          { "type": "basic", "name": "Span", "props": { "className": "text-sm font-medium text-gray-700 dark:text-gray-300" }, "text": "{{_computed.memPct}}%" }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2" },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "bg-green-500 h-2 rounded-full",
                              "style": { "width": "{{_computed.memPct}}%" }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "flex justify-between items-center mb-2" },
                        "children": [
                          { "type": "basic", "name": "Span", "props": { "className": "text-sm font-medium text-gray-700 dark:text-gray-300" }, "text": "Disk" },
                          { "type": "basic", "name": "Span", "props": { "className": "text-sm font-medium text-gray-700 dark:text-gray-300" }, "text": "{{_computed.diskPct}}%" }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2" },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "bg-amber-500 h-2 rounded-full",
                              "style": { "width": "{{_computed.diskPct}}%" }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_computed.vmMetricsAvailable}}",
                "props": { "className": "mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-sm" },
                "children": [
                  {
                    "type": "basic",
                    "name": "P",
                    "props": { "className": "rounded-lg bg-gray-50 dark:bg-gray-900/50 px-3 py-2 text-gray-900 dark:text-gray-100" },
                    "text": "{{'Load avg · ' + _computed.loadAvg}}"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": { "className": "rounded-lg bg-gray-50 dark:bg-gray-900/50 px-3 py-2 text-gray-900 dark:text-gray-100" },
                    "text": "{{'$t:moabom-system.admin.realtime_vm.uptime' + ' · ' + _computed.uptimeHours}}"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": { "className": "rounded-lg bg-gray-50 dark:bg-gray-900/50 px-3 py-2 text-gray-900 dark:text-gray-100" },
                    "text": "{{'Redis clients · ' + _computed.redisClients}}"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": { "className": "rounded-lg bg-gray-50 dark:bg-gray-900/50 px-3 py-2 text-gray-900 dark:text-gray-100" },
                    "text": "{{'$t:moabom-system.admin.realtime_vm.redis_memory' + ' · ' + _computed.redisMemory}}"
                  }
                ]
              },
              {
                "type": "basic",
                "name": "P",
                "if": "{{!_computed.vmMetricsAvailable}}",
                "props": { "className": "text-sm text-gray-500 dark:text-gray-400" },
                "text": "{{'$t:moabom-system.admin.realtime_vm.vm_metrics_unavailable' + (_computed.vmMetricsReason ? ' (' + _computed.vmMetricsReason + ')' : '')}}"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mt-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 shadow-sm"
            },
            "children": [
              {
                "type": "basic",
                "name": "H3",
                "props": { "className": "text-sm font-semibold text-gray-900 dark:text-white mb-3" },
                "text": "$t:moabom-system.admin.realtime_vm.card_services"
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_computed.vmMetricsAvailable}}",
                "props": { "className": "space-y-2 text-sm" },
                "children": [
                  {
                    "type": "basic",
                    "name": "P",
