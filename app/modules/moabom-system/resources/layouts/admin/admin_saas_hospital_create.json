{
  "version": "1.2.5",
  "layout_name": "admin_saas_hospital_create",
  "permissions": [
    "moabom-system.saas.create"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:moabom-system.admin.saas.hospitals.create_title",
    "description": "$t:moabom-system.admin.saas.hospitals.create_description"
  },
  "computed": {
    "slugValue": "{{(_local?.form?.slug || '').toLowerCase()}}",
    "slugTrim": "{{((_local?.form?.slug || '') + '').trim().toLowerCase()}}",
    "slugIsValid": "{{!!_local?.form?.slug && /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test((_local?.form?.slug || '').toLowerCase())}}",
    "slugShowInvalid": "{{!!_local?.form?.slug && !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test((_local?.form?.slug || '').toLowerCase())}}",
    "baseDomain": "{{_local?.baseDomain || 'mek360.com'}}",
    "previewHost": "{{((_local?.form?.slug || '').toLowerCase()) ? ((_local?.form?.slug || '').toLowerCase() + '.' + (_local?.baseDomain || 'mek360.com')) : ''}}",
    "slugAvailability": "{{slugCheck?.data || {}}}",
    "slugHostUnavailable": "{{_computed.slugIsValid && slugAvailability && slugAvailability.available === false}}",
    "submitDisabled": "{{_local?.isSaving || !_local?.form?.slug || !_local?.form?.name || !(/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test((_local?.form?.slug || '').toLowerCase())) || _computed.slugHostUnavailable}}"
  },
  "data_sources": [
    {
      "id": "slugCheck",
      "type": "api",
      "endpoint": "/api/modules/moabom-system/platform/saas/hospitals/slug-availability?slug={{_local.form.slug || ''}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true
    }
  ],
  "initLocal": {
    "form": {
      "slug": "",
      "name": "",
      "region": "",
      "note": "",
      "address": "",
      "logo_light": null,
      "logo_dark": null
    },
    "baseDomain": "mek360.com",
    "isSaving": false,
    "successHospital": null,
    "errors": null
  },
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "p-4 sm:p-6 lg:p-8 bg-gray-50 dark:bg-gray-900 min-h-screen"
        },
        "children": [
          {
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:moabom-system.admin.saas.hospitals.create_title",
              "description": "$t:moabom-system.admin.saas.hospitals.create_description"
            },
            "children": [
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "inline-flex items-center gap-1 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "chevron-left",
                      "className": "w-4 h-4"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "$t:moabom-system.admin.saas.hospitals.title"
                  }
                ],
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/admin/saas/hospitals"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{_local.successHospital}}",
            "props": {
              "className": "mt-6 max-w-3xl p-6 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex items-start gap-3"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "check-circle",
                      "className": "w-6 h-6 text-green-600 dark:text-green-400 shrink-0"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex-1"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "P",
                        "props": {
                          "className": "text-sm font-medium text-green-900 dark:text-green-100"
                        },
                        "text": "$t:moabom-system.admin.saas.hospitals.create_success"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "if": "{{_local.successHospital.display_name}}",
                        "props": {
                          "className": "mt-1 text-sm text-green-800 dark:text-green-200"
                        },
                        "text": "{{_local.successHospital.display_name}}{{(_local.successHospital.note || _local.successHospital.region) ? ' · ' + (_local.successHospital.note || _local.successHospital.region) : ''}}"
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-green-900 dark:text-green-100"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "slug: {{_local.successHospital.slug}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "host: {{_local.successHospital.host}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "db: {{_local.successHospital.database}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "gcs: {{_local.successHospital.gcs_prefix}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "package: {{_local.successHospital.package_id}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "mode: {{_local.successHospital.mode}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_local.successHospital.tables_bootstrapped}}",
                            "text": "tables: {{_local.successHospital.tables_bootstrapped}}"
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "mt-4 flex flex-wrap gap-2"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "A",
                            "props": {
                              "href": "{{_local.successHospital.app_url}}",
                              "target": "_blank",
                              "rel": "noopener noreferrer",
                              "className": "inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-medium"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "Icon",
                                "props": {
                                  "name": "external-link",
                                  "className": "w-4 h-4"
                                }
                              },
                              {
                                "type": "basic",
                                "name": "Span",
                                "text": "{{_local.successHospital.host}}"
                              }
                            ]
                          },
                          {
                            "type": "basic",
                            "name": "Button",
                            "props": {
                              "type": "button",
                              "className": "inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 border border-green-300 dark:border-green-700 text-green-800 dark:text-green-200 rounded-lg text-sm font-medium"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.title",
                            "actions": [
                              {
                                "type": "click",
                                "handler": "navigate",
                                "params": {
                                  "path": "/admin/saas/hospitals"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{!_local.successHospital}}",
            "props": {
              "className": "mt-6 max-w-3xl space-y-6"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                      "className": "text-lg font-semibold text-gray-900 dark:text-white mb-1"
                    },
                    "text": "$t:moabom-system.admin.saas.hospitals.create_form_section"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-sm text-gray-500 dark:text-gray-400 mb-6"
                    },
                    "text": "$t:moabom-system.admin.saas.hospitals.create_form_section_desc"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "space-y-4"
                    },
                    "children": [
                      {
                        "type": "composite",
                        "name": "FormField",
                        "props": {
                          "label": "$t:moabom-system.admin.saas.hospitals.field_slug",
                          "required": true,
                          "helperText": "$t:moabom-system.admin.saas.hospitals.field_slug_hint",
                          "error": "{{(typeof _local.errors === 'object' && _local.errors?.slug?.[0]) || (_computed.slugShowInvalid ? '$t:moabom-system.admin.saas.hospitals.field_slug_invalid' : '')}}"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                              "type": "text",
                              "value": "{{_local.form.slug}}",
                              "placeholder": "$t:moabom-system.admin.saas.hospitals.field_slug_placeholder",
                              "autoComplete": "off",
                              "disabled": "{{_local.isSaving}}",
                              "className": "admin-field-input"
                            },
                            "actions": [
                              {
                                "type": "change",
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "form.slug": "{{($event.target.value || '').toLowerCase().replace(/[^a-z0-9-]/g, '')}}"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "px-3 py-2 rounded-md bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 flex items-center gap-2 text-sm"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                              "className": "text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.host_preview"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_computed.previewHost}}",
                            "props": {
                              "className": "font-mono text-gray-800 dark:text-gray-100"
                            },
                            "text": "{{_computed.previewHost}}"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{!_computed.previewHost}}",
                            "props": {
                              "className": "text-gray-400 dark:text-gray-500 italic"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.host_preview_placeholder"
                          },
                          {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_computed.slugHostUnavailable}}",
                            "props": {
                              "className": "text-sm font-medium text-red-600 dark:text-red-400"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.host_unavailable"
                          }
                        ]
                      },
                      {
                        "type": "composite",
                        "name": "FormField",
                        "props": {
                          "label": "$t:moabom-system.admin.saas.hospitals.field_name",
                          "required": true,
                          "helperText": "$t:moabom-system.admin.saas.hospitals.field_name_hint",
                          "error": "{{(typeof _local.errors === 'object' && _local.errors?.name?.[0]) || ''}}"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                              "type": "text",
                              "value": "{{_local.form.name}}",
                              "placeholder": "$t:moabom-system.admin.saas.hospitals.field_name_placeholder",
                              "disabled": "{{_local.isSaving}}",
                              "className": "admin-field-input"
                            },
                            "actions": [
                              {
                                "type": "change",
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "form.name": "{{$event.target.value}}"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "composite",
                        "name": "FormField",
                        "props": {
                          "label": "$t:moabom-system.admin.saas.hospitals.field_address",
                          "error": "{{(typeof _local.errors === 'object' && _local.errors?.address?.[0]) || ''}}"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                              "type": "text",
                              "value": "{{_local.form.address}}",
                              "disabled": "{{_local.isSaving}}",
                              "className": "admin-field-input"
                            },
                            "actions": [
                              {
                                "type": "change",
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "form.address": "{{$event.target.value}}"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "composite",
                        "name": "FormField",
                        "props": {
                          "label": "$t:moabom-system.admin.saas.hospitals.field_note",
                          "error": "{{(typeof _local.errors === 'object' && (_local.errors?.note?.[0] || _local.errors?.region?.[0])) || ''}}"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                              "type": "text",
                              "value": "{{_local.form.note || _local.form.region}}",
                              "disabled": "{{_local.isSaving}}",
                              "className": "admin-field-input"
                            },
                            "actions": [
                              {
                                "type": "change",
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "form.note": "{{$event.target.value}}",
                                  "form.region": "{{$event.target.value}}"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "pt-4 border-t border-gray-200 dark:border-gray-700 space-y-4"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "H4",
                            "props": {
                              "className": "text-sm font-semibold text-gray-900 dark:text-white"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.logo_section"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "text-xs text-gray-500 dark:text-gray-400 -mt-2"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.logo_section_desc"
                          },
                          {
                            "type": "composite",
                            "name": "FormField",
                            "props": {
                              "label": "$t:moabom-system.admin.saas.hospitals.logo_light",
                              "helperText": "$t:moabom-system.admin.saas.hospitals.logo_optional_hint"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "FileInput",
                                "props": {
                                  "accept": ".jpg,.jpeg,.png,.gif,.webp,.svg",
                                  "disabled": "{{_local.isSaving}}",
                                  "className": "w-full",
                                  "buttonText": "$t:common.browse",
                                  "placeholder": "$t:moabom-system.admin.saas.hospitals.logo_no_file"
                                },
                                "actions": [
                                  {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "form.logo_light": "{{$event.target.files?.[0] || $event.target.value}}"
                                    }
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "composite",
                            "name": "FormField",
                            "props": {
                              "label": "$t:moabom-system.admin.saas.hospitals.logo_dark",
                              "helperText": "$t:moabom-system.admin.saas.hospitals.logo_optional_hint"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "FileInput",
                                "props": {
                                  "accept": ".jpg,.jpeg,.png,.gif,.webp,.svg",
                                  "disabled": "{{_local.isSaving}}",
                                  "className": "w-full",
                                  "buttonText": "$t:common.browse",
                                  "placeholder": "$t:moabom-system.admin.saas.hospitals.logo_no_file"
                                },
                                "actions": [
                                  {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "form.logo_dark": "{{$event.target.files?.[0] || $event.target.value}}"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.isSaving}}",
                        "props": {
                          "className": "p-3 rounded-md bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-sm text-blue-800 dark:text-blue-200"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "font-medium"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.submitting"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "props": {
                              "className": "mt-1 text-xs text-blue-700 dark:text-blue-300"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.submitting_hint"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.errors && !_local.isSaving}}",
                "props": {
                  "className": "bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex gap-3"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Icon",
                        "props": {
                          "name": "triangle-exclamation",
                          "className": "w-5 h-5 text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "children": [
                          {
                            "type": "basic",
                            "name": "H3",
                            "props": {
                              "className": "text-sm font-medium text-red-800 dark:text-red-200"
                            },
                            "text": "$t:moabom-system.admin.saas.hospitals.validation_failed"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "if": "{{typeof _local.errors === 'string'}}",
                            "props": {
                              "className": "mt-2 text-sm text-red-700 dark:text-red-300"
                            },
                            "text": "{{_local.errors}}"
                          },
                          {
                            "type": "basic",
                            "name": "Ul",
                            "if": "{{typeof _local.errors === 'object' && _local.errors !== null && Object.keys(_local.errors).length > 0}}",
                            "props": {
                              "className": "mt-2 list-disc list-inside space-y-1"
                            },
                            "iteration": {
                              "source": "Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                              "item_var": "message"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "Li",
                                "props": {
                                  "className": "text-sm text-red-700 dark:text-red-300"
                                },
                                "text": "{{message}}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex justify-end gap-3"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "className": "px-4 py-2 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 font-medium transition-colors"
                    },
                    "text": "$t:moabom-system.admin.saas.hospitals.cancel",
                    "actions": [
                      {
                        "type": "click",
                        "handler": "navigate",
                        "params": {
                          "path": "/admin/saas/hospitals"
                        }
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "disabled": "{{_computed.submitDisabled}}",
                      "className": "inline-flex items-center gap-2 px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Icon",
                        "if": "{{!_local.isSaving}}",
                        "props": {
                          "name": "plus",
                          "className": "w-4 h-4"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{_local.isSaving ? '$t:moabom-system.admin.saas.hospitals.submitting' : '$t:moabom-system.admin.saas.hospitals.submit'}}"
                      }
                    ],
                    "actions": [
                      {
                        "type": "click",
                        "handler": "sequence",
                        "params": {
                          "actions": [
                            {
                              "handler": "setState",
                              "params": {
                                "target": "local",
                                "isSaving": true,
                                "errors": null
                              }
                            },
                            {
                              "handler": "apiCall",
                              "auth_required": true,
                              "target": "/api/modules/moabom-system/platform/saas/hospitals",
                              "params": {
                                "method": "POST",
                                "contentType": "multipart/form-data",
                                "body": {
                                  "slug": "{{_local.form.slug}}",
                                  "name": "{{_local.form.name}}",
                                  "region": "{{_local.form.note || _local.form.region}}",
                                  "address": "{{_local.form.address}}",
                                  "logo_light": "{{_local.form.logo_light}}",
                                  "logo_dark": "{{_local.form.logo_dark}}",
                                  "note": "{{_local.form.note || _local.form.region}}"
                                }
                              },
                              "onSuccess": [
                                {
                                  "handler": "setState",
                                  "params": {
                                    "target": "local",
                                    "isSaving": false,
                                    "successHospital": "{{response.data?.hospital || null}}",
                                    "errors": null
                                  }
                                }
                              ],
                              "onError": [
                                {
                                  "handler": "setState",
                                  "params": {
                                    "target": "local",
                                    "isSaving": false,
                                    "errors": "{{(error?.errors && typeof error.errors === 'object' && Object.keys(error.errors).length > 0) ? error.errors : (error?.message ?? '$t:moabom-system.admin.saas.hospitals.create_error')}}"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
