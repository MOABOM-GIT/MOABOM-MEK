{
  "version": "1.1.0",
  "layout_name": "user/public_posts",
  "data_sources": [
    {
      "id": "user_profile",
      "type": "api",
      "endpoint": "/api/users/{{route.uuid}}/profile",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false
    },
    {
      "id": "user_posts_stats",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/users/{{route.uuid}}/posts/stats",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false
    },
    {
      "id": "user_posts",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/users/{{route.uuid}}/posts",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "params": {
        "per_page": 20,
        "page": 1,
        "sort": "latest"
      }
    }
  ],
  "components": [
    {
      "id": "user_public_posts_root",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "flex flex-col gap-4 p-4 min-h-0"
      },
      "children": [
        {
          "id": "user_posts_header_panel",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "glass-panel rounded-2xl border border-gray-200 dark:border-gray-700 p-4 flex flex-col gap-2 min-w-0"
          },
          "children": [
            {
              "id": "user_posts_header_author",
              "type": "composite",
              "name": "UserInfo",
              "props": {
                "author": "{{user_profile?.data}}",
                "showDropdown": true,
                "clickable": true,
                "layout": "horizontal"
              }
            },
            {
              "id": "user_posts_header_count",
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "text-xs text-muted whitespace-nowrap"
              },
              "text": "$t:moabom-presence.user.profile_posts_count|count={{user_posts_stats?.data?.posts_count ?? 0}}"
            }
          ]
        },
        {
          "id": "user_posts_view_tabs",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "moa-user-profile-tabs"
          },
          "children": [
            {
              "id": "user_posts_tab_profile",
              "type": "basic",
              "name": "Button",
              "props": {
                "className": "moa-user-profile-tab"
              },
              "actions": [
                {
                  "type": "click",
                  "handler": "navigate",
                  "params": {
                    "path": "/users/{{route.uuid}}"
                  }
                }
              ],
              "text": "$t:moabom-presence.user.profile_panel_title"
            },
            {
              "id": "user_posts_tab_posts",
              "type": "basic",
              "name": "Button",
              "props": {
                "className": "moa-user-profile-tab moa-user-profile-tab--active"
              },
              "text": "$t:moabom-presence.user.posts_list_title"
            }
          ]
        },
        {
          "id": "user_posts_empty",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "glass-panel rounded-2xl border border-gray-200 dark:border-gray-700 p-6 text-center"
          },
          "if": "{{!(user_posts?.data?.data?.length)}}",
          "children": [
            {
              "id": "user_posts_empty_text",
              "type": "basic",
              "name": "P",
              "props": {
                "className": "text-sm text-muted"
              },
              "text": "$t:moabom-presence.user.profile_posts_empty"
            }
          ]
        },
        {
          "id": "user_posts_list",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "flex flex-col gap-2 min-w-0"
          },
          "if": "{{user_posts?.data?.data?.length > 0}}",
          "iteration": {
            "source": "{{user_posts?.data?.data ?? []}}",
            "item_var": "post",
            "index_var": "postIndex"
          },
          "children": [
            {
              "id": "user_posts_row",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "moa-user-profile-post-card glass-panel rounded-2xl border border-gray-200 dark:border-gray-700 p-4 hover:border-blue-300 dark:hover:border-blue-700 transition-colors"
              },
              "children": [
                {
                  "id": "user_posts_row_top",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex items-center gap-2 min-w-0 flex-nowrap"
                  },
                  "children": [
                    {
                      "id": "user_posts_board_badge",
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "moa-user-profile-post-badge text-xs px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-medium"
                      },
                      "text": "{{post.board_name ?? post.board_slug ?? ''}}"
                    },
                    {
                      "id": "user_posts_row_new",
                      "type": "basic",
                      "name": "Span",
                      "if": "{{post.is_new}}",
                      "props": {
                        "className": "moa-board-badge-new shrink-0"
                      },
                      "text": "N"
                    }
                  ]
                },
                {
                  "id": "user_posts_row_title",
                  "type": "basic",
                  "name": "Button",
                  "props": {
                    "className": "moa-user-profile-post-card__title text-primary"
                  },
                  "actions": [
                    {
                      "type": "click",
                      "handler": "navigate",
                      "params": {
                        "path": "/board/{{post.board_slug}}/{{post.id}}"
                      }
                    }
                  ],
                  "text": "{{post.title}}"
                },
                {
                  "id": "user_posts_row_meta",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "moa-user-profile-post-card__meta"
                  },
                  "children": [
                    {
                      "id": "user_posts_row_date",
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "whitespace-nowrap",
                        "title": "{{post.created_at ?? ''}}"
                      },
                      "text": "{{post.created_at_formatted ?? post.created_at ?? ''}}"
                    },
                    {
                      "id": "user_posts_row_views",
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "whitespace-nowrap shrink-0"
                      },
                      "if": "{{post.view_count != null}}",
                      "text": "$t:moabom-presence.user.post_views|count={{post.view_count ?? 0}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
