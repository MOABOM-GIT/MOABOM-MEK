{
  "version": "1.1.0",
  "layout_name": "user/public_posts",
  "data_sources": [
    {
      "id": "user_profile",
      "type": "api",
      "endpoint": "/api/users/{{route.uuid}}/profile",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false
    },
    {
      "id": "user_posts_stats",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/users/{{route.uuid}}/posts/stats",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false
    },
    {
      "id": "user_posts",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/users/{{route.uuid}}/posts",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "params": {
        "per_page": 20,
        "page": 1,
        "sort": "latest"
      }
    },
    {
      "id": "user_generated_apps",
      "type": "api",
      "endpoint": "/api/modules/moabom-apps/users/{{route.uuid}}/generated-apps",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "params": {
        "per_page": 20,
        "page": 1
      }
    },
    {
      "id": "user_frequent_apps",
      "type": "api",
      "endpoint": "/api/modules/moabom-apps/users/{{route.uuid}}/frequent-apps",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "params": {
        "limit": 5
      }
    }
  ],
  "components": [
    {
      "id": "user_public_posts_root",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "flex flex-col gap-4 p-4 min-h-0"
      },
      "children": [
        {
          "id": "user_posts_header_panel",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "moa-group rounded-2xl border border-gray-200 dark:border-gray-700 p-4 flex flex-col gap-2 min-w-0"
          },
          "children": [
            {
              "id": "user_posts_header_author",
              "type": "composite",
              "name": "UserInfo",
              "props": {
                "author": "{{user_profile?.data}}",
                "showDropdown": true,
                "clickable": true,
                "layout": "horizontal"
              }
            },
            {
              "id": "user_posts_header_count",
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "text-xs text-muted whitespace-nowrap"
              },
              "text": "$t:moabom-presence.user.profile_posts_count|count={{user_posts_stats?.data?.posts_count ?? 0}}"
            }
          ]
        },
        {
          "id": "user_posts_view_tabs",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "moa-user-profile-tabs"
          },
          "children": [
            {
              "id": "user_posts_tab_profile",
              "type": "basic",
              "name": "Button",
              "props": {
                "className": "moa-user-profile-tab"
              },
              "actions": [
                {
                  "type": "click",
                  "handler": "navigate",
                  "params": {
                    "path": "/users/{{route.uuid}}"
                  }
                }
              ],
              "text": "$t:moabom-presence.user.profile_panel_title"
            },
            {
              "id": "user_posts_tab_posts",
              "type": "basic",
              "name": "Button",
              "props": {
                "className": "moa-user-profile-tab moa-user-profile-tab--active"
              },
              "text": "$t:moabom-presence.user.posts_list_title"
            }
          ]
        },
        {
          "id": "user_generated_apps_panel",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "moa-group rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden min-w-0"
          },
          "children": [
            {
              "id": "user_generated_apps_title",
              "type": "basic",
              "name": "H2",
              "props": {
                "className": "px-4 pt-4 pb-2 text-sm font-semibold text-muted"
              },
              "text": "$t:moabom-presence.user.generated_apps_title"
            },
            {
              "id": "user_generated_apps_empty",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "px-4 pb-4 text-sm text-muted text-center"
              },
              "if": "{{!(user_generated_apps?.data?.data?.length)}}",
              "text": "$t:moabom-presence.user.generated_apps_empty"
            },
            {
              "id": "user_generated_apps_list",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "moa-user-profile-post-list min-w-0 pb-2"
              },
              "if": "{{user_generated_apps?.data?.data?.length > 0}}",
              "iteration": {
                "source": "{{user_generated_apps?.data?.data ?? []}}",
                "item_var": "app",
                "index_var": "appIndex"
              },
              "children": [
                {
                  "partial": "../partials/user/_user_generated_app_row.json"
                }
              ]
            }
          ]
        },
        {
          "id": "user_frequent_apps_panel",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "moa-group rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden min-w-0"
          },
          "children": [
            {
              "id": "user_frequent_apps_title",
              "type": "basic",
              "name": "H2",
              "props": {
                "className": "px-4 pt-4 pb-2 text-sm font-semibold text-muted"
              },
              "text": "$t:moabom-presence.user.frequent_apps_title"
            },
            {
              "id": "user_frequent_apps_empty",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "px-4 pb-4 text-sm text-muted text-center"
              },
              "if": "{{!(user_frequent_apps?.data?.data?.length)}}",
              "text": "$t:moabom-presence.user.frequent_apps_empty"
            },
            {
              "id": "user_frequent_apps_list",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "moa-user-profile-post-list min-w-0 pb-2"
              },
              "if": "{{user_frequent_apps?.data?.data?.length > 0}}",
              "iteration": {
                "source": "{{user_frequent_apps?.data?.data ?? []}}",
                "item_var": "app",
                "index_var": "frequentAppIndex"
              },
              "children": [
                {
                  "partial": "../partials/user/_user_generated_app_row.json"
                }
              ]
            }
          ]
        },
        {
          "id": "user_posts_panel",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "moa-group rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden min-w-0"
          },
          "children": [
            {
              "id": "user_posts_list_title",
              "type": "basic",
              "name": "H2",
              "props": {
                "className": "px-4 pt-4 pb-2 text-sm font-semibold text-muted"
              },
              "text": "$t:moabom-presence.user.profile_posts_title"
            },
            {
              "id": "user_posts_empty",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "px-4 pb-6 text-sm text-muted text-center"
              },
              "if": "{{!(user_posts?.data?.data?.length)}}",
              "text": "$t:moabom-presence.user.profile_posts_empty"
            },
            {
              "id": "user_posts_list_body",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "moa-user-profile-post-list min-w-0 pb-2"
              },
              "if": "{{user_posts?.data?.data?.length > 0}}",
              "iteration": {
                "source": "{{user_posts?.data?.data ?? []}}",
                "item_var": "post",
                "index_var": "postIndex"
              },
              "children": [
                {
                  "partial": "../partials/user/_user_post_row.json"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
