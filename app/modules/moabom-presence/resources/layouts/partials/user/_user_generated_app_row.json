{
  "meta": {
    "is_partial": true,
    "description": "공개 프로필 유저 활동 — 제작앱 1행"
  },
  "type": "basic",
  "name": "Button",
  "props": {
    "className": "moa-user-profile-post-row w-full min-w-0 cursor-pointer text-left"
  },
  "actions": [
    {
      "type": "click",
      "handler": "navigate",
      "params": {
        "path": "/app/{{app.shell_id ?? app.id}}"
      }
    }
  ],
  "children": [
    {
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "moa-user-profile-post-badge text-xs px-2 py-0.5 rounded bg-violet-50 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400 font-medium"
      },
      "text": "$t:moabom-presence.user.generated_apps_title"
    },
    {
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "moa-user-profile-post-title min-w-0 truncate"
      },
      "text": "{{app.title ?? ''}}"
    }
  ]
}
