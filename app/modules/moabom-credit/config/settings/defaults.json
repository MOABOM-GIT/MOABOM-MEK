{
  "_meta": {
    "version": "0.1.2",
    "description": "Moabom credit reward settings",
    "categories": ["rewards", "limits", "ads", "levels"]
  },
  "defaults": {
    "levels": {
      "thresholds": [0, 100, 300, 700, 1500, 3000, 6000, 12000, 25000, 50000]
    },
    "rewards": {
      "login_enabled": true,
      "login_amount": 5,
      "post_write_enabled": true,
      "post_write_amount": 20,
      "like_received_enabled": true,
      "like_received_amount": 2,
      "comment_write_enabled": true,
      "comment_write_amount": 2,
      "app_review_write_enabled": true,
      "app_review_write_amount": 3,
      "attendance_enabled": true,
      "attendance_amount": 10
    },
    "limits": {
      "daily_earn_limit": 500,
      "attendance_daily_limit": 1,
      "max_post_write_rewards_per_day": 10,
      "max_like_received_rewards_per_day": 50,
      "max_comment_write_rewards_per_day": 20,
      "max_app_review_write_rewards_per_day": 10
    },
    "ads": {
      "attendance_requires_ad": false,
      "attendance_ad_provider": "google",
      "attendance_ad_reward_multiplier": 1
    }
  },
  "frontend_schema": {
    "rewards": {
      "expose": true,
      "fields": {
        "attendance_enabled": { "expose": true },
        "attendance_amount": { "expose": true }
      }
    },
    "limits": {
      "expose": true,
      "fields": {
        "attendance_daily_limit": { "expose": true }
      }
    },
    "ads": {
      "expose": true,
      "fields": {
        "attendance_requires_ad": { "expose": true },
        "attendance_ad_provider": { "expose": true }
      }
    },
    "levels": {
      "expose": true,
      "fields": {
        "thresholds": { "expose": true }
      }
    }
  }
}
