{
  "meta": {
    "is_partial": true,
    "description": "Credit management - delete credit data modal"
  },
  "id": "modal_delete_credit",
  "type": "composite",
  "name": "Modal",
  "props": {
    "title": "$t:moabom-credit.admin.user_credits.delete_modal.title",
    "description": "$t:moabom-credit.admin.user_credits.delete_modal.description",
    "size": "md"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "space-y-4"
      },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-4"
          },
          "children": [
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "text-sm text-red-800 dark:text-red-200"
              },
              "text": "$t:moabom-credit.admin.user_credits.delete_modal.warning"
            }
          ]
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "rounded-lg bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 p-3 text-sm"
          },
          "children": [
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "font-medium text-gray-900 dark:text-white"
              },
              "text": "{{_global.creditDeleteTarget?.name || ''}}{{_global.creditDeleteTarget?.nickname ? ' (' + _global.creditDeleteTarget.nickname + ')' : ''}}"
            },
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "text-gray-600 dark:text-gray-300 mt-1"
              },
              "text": "{{_global.creditDeleteTarget?.email || ''}}"
            },
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "mt-3 grid grid-cols-2 gap-3 text-sm"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-gray-500 dark:text-gray-400"
                      },
                      "text": "$t:moabom-credit.admin.user_credits.columns.balance"
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "props": {
                        "className": "font-mono font-semibold text-gray-900 dark:text-white"
                      },
                      "text": "{{_global.creditDeleteTarget?.balance ?? 0}}"
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-gray-500 dark:text-gray-400"
                      },
                      "text": "$t:moabom-credit.admin.user_credits.columns.ranking_points"
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "props": {
                        "className": "font-mono font-semibold text-gray-900 dark:text-white"
                      },
                      "text": "{{_global.creditDeleteTarget?.ranking_points ?? 0}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "flex justify-end gap-3 mt-6"
      },
      "children": [
        {
          "type": "basic",
          "name": "Button",
          "props": {
            "type": "button",
            "disabled": "{{_global.creditIsDeleting}}",
            "className": "px-4 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300"
          },
          "text": "$t:common.cancel",
          "actions": [
            {
              "type": "click",
              "handler": "closeModal"
            }
          ]
        },
        {
          "type": "basic",
          "name": "Button",
          "props": {
            "type": "button",
            "disabled": "{{_global.creditIsDeleting}}",
            "className": "px-4 py-2 text-sm bg-red-600 text-white rounded-lg font-medium hover:bg-red-700 disabled:opacity-50"
          },
          "text": "{{_global.creditIsDeleting ? '$t:moabom-credit.admin.user_credits.delete_modal.submitting' : '$t:moabom-credit.admin.user_credits.delete_modal.submit'}}",
          "actions": [
            {
              "type": "click",
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": {
                    "target": "global",
                    "creditIsDeleting": true
                  }
                },
                {
                  "handler": "apiCall",
                  "auth_required": true,
                  "target": "/api/modules/moabom-credit/admin/user-credits/{{_global.creditDeleteTarget?.uuid}}",
                  "params": {
                    "method": "DELETE"
                  },
                  "onSuccess": [
                    {
                      "handler": "setState",
                      "params": {
                        "target": "global",
                        "creditIsDeleting": false
                      }
                    },
                    {
                      "handler": "refetchDataSource",
                      "params": {
                        "dataSourceId": "userCredits"
                      }
                    },
                    {
                      "handler": "toast",
                      "params": {
                        "type": "success",
                        "message": "$t:moabom-credit.admin.user_credits.delete_modal.success"
                      }
                    },
                    {
                      "handler": "closeModal"
                    }
                  ],
                  "onError": [
                    {
                      "handler": "setState",
                      "params": {
                        "target": "global",
                        "creditIsDeleting": false
                      }
                    },
                    {
                      "handler": "toast",
                      "params": {
                        "type": "error",
                        "message": "{{error.message || '$t:moabom-credit.admin.user_credits.delete_modal.error'}}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
