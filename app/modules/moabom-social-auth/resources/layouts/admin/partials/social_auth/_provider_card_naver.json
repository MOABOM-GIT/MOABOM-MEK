{
  "meta": {
    "is_partial": true,
    "description": "Naver SNS 연결 설정 카드"
  },
  "id": "naver_provider_card",
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm p-5"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "flex items-center justify-between gap-4 mb-5"
      },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "children": [
            {
              "type": "basic",
              "name": "H3",
              "props": {
                "className": "text-lg font-semibold text-gray-900 dark:text-white"
              },
              "text": "Naver"
            },
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "mt-1 text-sm text-gray-500 dark:text-gray-400"
              },
              "text": "$t:moabom-social-auth.admin.settings.providers.naver_description"
            }
          ]
        },
        {
          "type": "basic",
          "name": "Input",
          "props": {
            "name": "providers.naver_enabled",
            "type": "checkbox",
            "disabled": "{{_computed.isReadOnly}}",
            "className": "w-5 h-5 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:bg-gray-800"
          }
        }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "space-y-4"
      },
      "children": [
        {
          "partial": "partials/social_auth/_provider_master_inherit_banner.json"
        },
        {
          "type": "basic",
          "name": "Label",
          "if": "{{_computed.canManageCredentials}}",
          "props": {
            "className": "flex items-start gap-2 rounded-lg bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800 p-3"
          },
          "children": [
            {
              "type": "basic",
              "name": "Input",
              "props": {
                "name": "providers.naver_use_master_defaults",
                "type": "checkbox",
                "disabled": "{{_computed.isReadOnly}}",
                "className": "mt-0.5 w-4 h-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:bg-gray-800"
              }
            },
            {
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "text-xs text-indigo-800 dark:text-indigo-200"
              },
              "text": "$t:moabom-social-auth.admin.settings.fields.use_master_defaults"
            }
          ]
        },
        {
          "type": "basic",
          "name": "Label",
          "props": {
            "className": "{{_computed.credentialLabelClassName}}"
          },
          "text": "$t:moabom-social-auth.admin.settings.fields.client_id"
        },
        {
          "type": "basic",
          "name": "Input",
          "props": {
            "name": "providers.naver_client_id",
            "type": "text",
            "value": "{{_local.form?.providers?.naver_client_id ?? ''}}",
            "placeholder": "Naver Client ID",
            "disabled": "{{_computed.credentialInputsLocked || _local.form?.providers?.naver_use_master_defaults === true}}",
            "className": "{{_computed.credentialInputClassName}}"
          }
        },
        {
          "type": "basic",
          "name": "Label",
          "props": {
            "className": "{{_computed.credentialLabelClassName}}"
          },
          "text": "$t:moabom-social-auth.admin.settings.fields.client_secret"
        },
        {
          "type": "basic",
          "name": "Input",
          "props": {
            "name": "providers.naver_client_secret",
            "type": "password",
            "value": "{{_local.form?.providers?.naver_client_secret ?? ''}}",
            "autoComplete": "new-password",
            "placeholder": "Naver Client Secret",
            "disabled": "{{_computed.credentialInputsLocked || _local.form?.providers?.naver_use_master_defaults === true}}",
            "className": "{{_computed.credentialInputClassName}}"
          }
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "rounded-lg bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 p-3"
          },
          "children": [
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "mb-2 text-xs font-medium text-gray-700 dark:text-gray-300"
              },
              "text": "$t:moabom-social-auth.admin.settings.fields.provider_callback_url"
            },
            {
              "type": "basic",
              "name": "Input",
              "props": {
                "type": "text",
                "value": "{{settings?.data?.callback_urls?.naver ?? ''}}",
                "readOnly": true,
                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-xs"
              }
            },
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "mt-2 text-xs text-gray-500 dark:text-gray-400"
              },
              "text": "$t:moabom-social-auth.admin.settings.callback_url_hint"
            }
          ]
        },
        {
          "type": "basic",
          "name": "A",
          "props": {
            "href": "https://developers.naver.com/apps/#/register",
            "target": "_blank",
            "rel": "noopener noreferrer",
            "className": "inline-flex items-center justify-center w-full px-3 py-2 text-sm font-medium text-green-700 dark:text-green-300 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg hover:bg-green-100 dark:hover:bg-green-900/30 transition-colors no-underline"
          },
          "text": "$t:moabom-social-auth.admin.settings.links.naver_credentials"
        }
      ]
    }
  ]
}
