# ===== 확장 시스템 (MOABOM-MEK: 활성 경로 = Git SSOT) =====

# upstream 미러·스테이징 (루트 .gitignore 와 동일 정책)
modules/_bundled/
modules/_pending/
plugins/_bundled/
plugins/_pending/
templates/_bundled/
templates/_pending/
lang-packs/_bundled/
lang-packs/_pending/

# 확장 내부 빌드·의존성 (소스만 Git, dist/node_modules 는 Cloud Build)
modules/*/node_modules/
modules/*/vendor/
modules/*/dist/
plugins/*/node_modules/
plugins/*/vendor/
plugins/*/dist/
templates/*/node_modules/
templates/*/dist/

# DevTools debug dump
storage/debug-dump/

# MaxMind GeoLite2 DB (재배포 금지 — 각 환경에서 직접 다운로드)
storage/app/geoip/

# 인스톨러 런타임 산출물 — 각 환경에서 자동 생성/소비
storage/installer-state.json
storage/installer/

# 개발 전용 파일
.api-test/
.serena/
.claudeignore
.mcp.json
boost.json
cypress/
cypress.config.js
.env.testing

