{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases — baseUrl 제거(TS 6 deprecated), paths에 접두사 인라인 */
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "moabom-shell-i18n": ["./src/i18n/moabomShellI18nSingleton.ts"],
      "moabom-create-app-edit": ["./src/apps/ai-generator/moabomCreateAppEditSession.ts"],
      "moabom-create-app-prompt": ["./src/apps/ai-generator/moabomCreateAppPromptSession.ts"],
      "moabom-ai-generation-activity": ["./src/apps/ai-generator/aiGenerationActivity.ts"],
      "@moabom-consulting/simulation-model.json": ["../../modules/moabom-consulting/resources/simulation-model.json"],
      "@moabom-cpap/recommend-rules.json": ["../../modules/moabom-cpap/resources/recommend-rules.json"],
      "@moabom-cpap/recommend-parity-fixtures.json": ["../../modules/moabom-cpap/resources/recommend-parity-fixtures.json"]
    },

    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__/layouts/**"
  ]
}
