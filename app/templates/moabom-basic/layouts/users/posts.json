{
  "version": "1.1.0",
  "layout_name": "users/posts",
  "permissions": [],
  "meta": {
    "seo": {
      "enabled": true,
      "data_sources": [
        "userProfile"
      ],
      "priority": 0.3,
      "changefreq": "weekly",
      "og": {
        "type": "profile"
      }
    }
  },
  "data_sources": [
    {
      "id": "userProfile",
      "type": "api",
      "endpoint": "/api/users/{{route.userId}}/profile",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "refetchOnMount": true,
      "loading_strategy": "progressive",
      "errorHandling": {
        "404": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        }
      }
    },
    {
      "id": "userGeneratedApps",
      "type": "api",
      "endpoint": "/api/modules/moabom-apps/users/{{route.userId}}/generated-apps",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "loading_strategy": "progressive",
      "params": {
        "per_page": 20,
        "page": 1
      }
    },
    {
      "id": "userFrequentApps",
      "type": "api",
      "endpoint": "/api/modules/moabom-apps/users/{{route.userId}}/frequent-apps",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "loading_strategy": "progressive",
      "params": {
        "limit": 10
      }
    },
    {
      "id": "userPosts",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/users/{{route.userId}}/posts",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": false,
      "loading_strategy": "progressive",
      "params": {
        "page": "{{query.page || 1}}",
        "per_page": 20
      }
    }
  ],
  "components": [
    {
      "type": "layout",
      "name": "Container",
      "props": {
        "className": "py-8"
      },
      "children": [
        {
          "comment": "활동 — 마이앱 · 최근 실행 앱 · 작성글",
          "type": "basic",
          "name": "Div",
          "if": "{{userProfile.data && !userProfile.error}}",
          "props": {
            "className": "space-y-2"
          },
          "children": [
            {
              "comment": "마이앱 패널",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "moa-group rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "H3",
                  "props": {
                    "className": "moa-user-profile-section-title moa-user-profile-section-title--bar"
                  },
                  "text": "$t:user.profile.generated_apps_title"
                },
                {
                  "type": "composite",
                  "name": "PanelEmptyState",
                  "if": "{{!(userGeneratedApps.data?.data?.length)}}",
                  "props": {
                    "icon": "cube",
                    "message": "$t:user.profile.generated_apps_empty"
                  }
                },
                {
                  "type": "composite",
                  "name": "UserProfileAppGrid",
                  "if": "{{userGeneratedApps.data?.data?.length > 0}}",
                  "props": {
                    "apps": "{{userGeneratedApps.data?.data ?? []}}"
                  }
                }
              ]
            },
            {
              "comment": "최근 실행 앱 패널 (최대 10)",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "moa-group rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "H3",
                  "props": {
                    "className": "moa-user-profile-section-title moa-user-profile-section-title--bar"
                  },
                  "text": "$t:user.profile.frequent_apps_title"
                },
                {
                  "type": "composite",
                  "name": "PanelEmptyState",
                  "if": "{{!(userFrequentApps.data?.data?.length)}}",
                  "props": {
                    "icon": "clock",
                    "message": "$t:user.profile.frequent_apps_empty"
                  }
                },
                {
                  "type": "composite",
                  "name": "UserProfileAppGrid",
                  "if": "{{userFrequentApps.data?.data?.length > 0}}",
                  "props": {
                    "apps": "{{userFrequentApps.data?.data ?? []}}",
                    "maxItems": 10
                  }
                }
              ]
            },
            {
              "comment": "작성글 패널",
              "type": "basic",
              "name": "Div",
              "if": "{{userPosts.data && !userPosts.error}}",
              "props": {
                "className": "moa-group rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "H3",
                  "props": {
                    "className": "moa-user-profile-section-title moa-user-profile-section-title--bar"
                  },
                  "text": "$t:user.profile.posts_section_title"
                },
                {
                  "comment": "게시글 없음",
                  "type": "composite",
                  "name": "PanelEmptyState",
                  "if": "{{!userPosts.data?.data?.length}}",
                  "props": {
                    "icon": "file-alt",
                    "message": "$t:user.profile.no_posts"
                  }
                },
                {
                  "comment": "게시글 목록",
                  "type": "basic",
                  "name": "Div",
                  "if": "{{userPosts.data?.data?.length > 0}}",
                  "props": {
                    "className": "moa-user-profile-post-list min-w-0"
                  },
                  "iteration": {
                    "source": "{{userPosts.data?.data ?? []}}",
                    "item_var": "post"
                  },
                  "children": [
                    {
                      "partial": "../partials/users/_user_post_row.json"
                    }
                  ]
                },
                {
                  "comment": "페이지네이션",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex justify-center py-6"
                  },
                  "children": [
                    {
                      "type": "composite",
                      "name": "Pagination",
                      "props": {
                        "currentPage": "{{userPosts.data?.current_page ?? 1}}",
                        "totalPages": "{{userPosts.data?.last_page ?? 1}}"
                      },
                      "actions": [
                        {
                          "event": "onPageChange",
                          "handler": "navigate",
                          "params": {
                            "path": "/users/{{route.userId}}/posts",
                            "mergeQuery": true,
                            "query": {
                              "page": "{{$args[0]}}"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
