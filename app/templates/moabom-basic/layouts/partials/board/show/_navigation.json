{
  "meta": {
    "is_partial": true,
    "description": "게시글 상단 네비게이션. 목록으로 버튼 + 게시판 이름 + 이전글/다음글 버튼"
  },
  "comment": "상단 네비게이션 버튼",
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "grid grid-cols-[1fr_auto_1fr] items-center gap-2 mb-3"
  },
  "children": [
    {
      "comment": "좌측 영역 (목록 버튼)",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "flex items-center justify-start min-w-0"
      },
      "children": [
        {
          "comment": "목록으로 버튼",
          "type": "basic",
          "name": "Button",
          "props": {
            "className": "flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-white glass-panel border border-gray-300 dark:border-gray-600 rounded-lg hover:opacity-90 transition-all cursor-pointer"
          },
          "actions": [
            {
              "type": "click",
              "handler": "navigate",
              "params": {
                "path": "/board/{{route.slug}}"
              }
            }
          ],
          "children": [
            {
              "type": "basic",
              "name": "Icon",
              "props": {
                "name": "list",
                "size": "sm"
              }
            },
            {
              "type": "basic",
              "name": "Span",
              "text": "$t:board.back_to_list"
            }
          ]
        }
      ]
    },
    {
      "comment": "게시판 이름 (가운데)",
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "text-lg font-semibold text-gray-900 dark:text-white text-center truncate px-1"
      },
      "text": "{{post?.data?.board?.name ?? ''}}"
    },
    {
      "comment": "우측 영역 (이전글/다음글)",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "flex items-center justify-end gap-2 min-w-0"
      },
      "children": [
        {
          "comment": "이전글 버튼 - 아이콘 + 텍스트",
          "type": "basic",
          "name": "Button",
          "if": "{{navigation?.data?.prev?.id}}",
          "props": {
            "className": "flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-4 py-2 text-sm font-medium text-gray-700 dark:text-white glass-panel border border-gray-300 dark:border-gray-600 rounded-lg hover:opacity-90 transition-all cursor-pointer",
            "aria-label": "$t:board.prev"
          },
          "actions": [
            {
              "type": "click",
              "handler": "navigate",
              "params": {
                "path": "/board/{{route.slug}}/{{navigation.data.prev.id}}",
                "query": {
                  "del": "{{query.del ?? ''}}"
                }
              }
            }
          ],
          "children": [
            {
              "type": "composite",
              "name": "Icon",
              "props": {
                "name": "chevron-left",
                "size": "sm"
              }
            },
            {
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "hidden sm:inline"
              },
              "text": "$t:board.prev"
            }
          ]
        },
        {
          "comment": "다음글 버튼 - 아이콘 + 텍스트",
          "type": "basic",
          "name": "Button",
          "if": "{{navigation?.data?.next?.id}}",
          "props": {
            "className": "flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-4 py-2 text-sm font-medium text-gray-700 dark:text-white glass-panel border border-gray-300 dark:border-gray-600 rounded-lg hover:opacity-90 transition-all cursor-pointer",
            "aria-label": "$t:board.next"
          },
          "actions": [
            {
              "type": "click",
              "handler": "navigate",
              "params": {
                "path": "/board/{{route.slug}}/{{navigation.data.next.id}}",
                "query": {
                  "del": "{{query.del ?? ''}}"
                }
              }
            }
          ],
          "children": [
            {
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "hidden sm:inline"
              },
              "text": "$t:board.next"
            },
            {
              "type": "composite",
              "name": "Icon",
              "props": {
                "name": "chevron-right",
                "size": "sm"
              }
            }
          ]
        }
      ]
    }
  ]
}
