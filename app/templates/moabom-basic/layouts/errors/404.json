{
    "version": "1.0.0",
    "layout_name": "404",
    "meta": {
        "title": "$t:errors.404_title"
    },
    "components": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "min-h-screen flex flex-col items-center justify-center bg-gray-50 px-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": { "className": "max-w-lg text-center" },
                    "children": [
                        {
                            "type": "basic",
                            "name": "H1",
                            "props": { "className": "text-6xl font-bold text-gray-300 mb-4" },
                            "text": "404"
                        },
                        {
                            "type": "basic",
                            "name": "H2",
                            "props": { "className": "text-2xl font-bold text-gray-700 mb-2" },
                            "text": "$t:errors.404_title"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": { "className": "text-gray-500 mb-8" },
                            "text": "$t:errors.404_message"
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "props": { "className": "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer" },
                            "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/" } }],
                            "text": "$t:errors.go_home"
                        }
                    ]
                }
            ]
        }
    ]
}
