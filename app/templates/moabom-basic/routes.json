{
  "version": "1.0.4",
  "description": "moabom 사용자 템플릿 라우트 정의",
  "routes": [
    {
      "path": "/",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "홈"
      }
    },
    {
      "path": "/me",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "마이페이지"
      }
    },
    {
      "path": "/me/:tab",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "마이페이지"
      }
    },
    {
      "path": "/auth/:mode",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "인증"
      }
    },
    {
      "path": "/app/:id",
      "layout": "seo/app_detail",
      "auth_required": false,
      "meta": {
        "title": "앱"
      }
    },
    {
      "path": "/apps",
      "layout": "seo/apps_index",
      "auth_required": false,
      "meta": {
        "title": "MOABOM APPS"
      }
    },
    {
      "_comment": "게시판 — 셸(HomePage) + 윈도우 내 G7 board JSON (moabom-shell-board-window.md)",
      "path": "/board/:slug",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "게시판"
      }
    },
    {
      "path": "/board/:slug/write",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "게시글 작성"
      }
    },
    {
      "path": "/board/:slug/:id",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "게시글"
      }
    },
    {
      "path": "/board/:slug/:id/edit",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "게시글 수정"
      }
    },
    {
      "_comment": "공개 프로필 — 셸 윈도우 내 G7 users/show JSON",
      "path": "/users/:uuid",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "사용자 프로필"
      }
    },
    {
      "_comment": "유저 활동 — 셸 윈도우 내 G7 users/posts JSON + 제작앱 목록",
      "path": "/users/:uuid/posts",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "유저 활동"
      }
    },
    {
      "_comment": "대화하기 — 셸 윈도우 내 Moabom chat panel",
      "path": "/users/:uuid/chat",
      "layout": "home",
      "auth_required": true,
      "meta": {
        "title": "대화하기"
      }
    },
    {
      "path": "/login",
      "layout": "auth/login",
      "auth_required": false,
      "guest_only": true,
      "meta": {
        "title": "로그인"
      }
    },
    {
      "path": "/register",
      "layout": "auth/register",
      "auth_required": false,
      "guest_only": true,
      "meta": {
        "title": "회원가입"
      }
    },
    {
      "path": "/forgot-password",
      "layout": "auth/forgot-password",
      "auth_required": false,
      "guest_only": true,
      "meta": {
        "title": "비밀번호 찾기"
      }
    },
    {
      "path": "/reset-password",
      "layout": "auth/reset-password",
      "auth_required": false,
      "guest_only": true,
      "meta": {
        "title": "비밀번호 재설정"
      }
    },
    {
      "_comment": "에러 — 셸(HomePage) + 윈도우 내 G7 errors JSON",
      "path": "/404",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "페이지를 찾을 수 없습니다"
      }
    },
    {
      "path": "/403",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "접근 권한이 없습니다"
      }
    },
    {
      "path": "/500",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "서버 오류"
      }
    },
    {
      "path": "/503",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "서비스 점검"
      }
    },
    {
      "path": "/maintenance",
      "layout": "home",
      "auth_required": false,
      "meta": {
        "title": "점검 중"
      }
    }
  ]
}
