# docker compose 환경 (프로젝트 루트, WSL 로컬 부트 전용)
# cp .env.example .env 후 수정. 이 파일은 GCP 배포에 사용되지 않습니다.
#
# WSL에서 호스트 UID/GID (권한 충돌 시 id -u / id -g 로 확인 후 맞출 것)
PUID=1000
PGID=1000

HTTP_PORT=8080
MYSQL_PORT=3307
MYSQL_DATABASE=moabom-db
MYSQL_USER=moabom
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=rootpass

# Cloud Build / Cloud Run 배포 식별자는 deploy/lib/gcp-env.sh SSOT 만 사용합니다.
# (project / region / Cloud Run service / Cloud SQL / Artifact Registry / GCS bucket)
# override 가 필요하면 다음 변수를 export 하세요:
#   GCP_PROJECT_ID   (기본: smartmek)
#   GCP_REGION       (기본: asia-northeast3)
#   CLOUD_RUN_SERVICE
#   CLOUDSQL_INSTANCE
#   GCP_ARTIFACT_REPO
# 시크릿(DB 패스워드·APP_KEY·SNS OAuth secret)은 Google Secret Manager 에서 주입됩니다.
# 부트스트랩: bash deploy/secret-manager-bootstrap.sh
