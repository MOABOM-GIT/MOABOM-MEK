     private function invalidateSettingsCache(): void
     {
         $this->cache->forget('settings.system');
+
+        if ($this->shouldSkipConfigClear()) {
+            return;
+        }
+
         Artisan::call('config:clear');
     }
 
+    /**
+     * config:clear 생략 가드.
+     *
+     * 코어는 특정 확장(모듈/플러그인) 클래스를 직접 참조하지 않고,
+     * core.config_clear_guards 설정을 통해 런타임 정책을 주입받습니다.
+     *
+     * guard 예시:
+     * [
+     *   'enabled_config' => 'my-module.feature.enabled',
+     *   'bound_abstract' => App\\Support\\RequestScopedContext::class,
+     *   'context_not_null_method' => 'current',
+     * ]
+     */
+    private function shouldSkipConfigClear(): bool
+    {
+        $guards = config('core.config_clear_guards', []);
+        if (! is_array($guards) || $guards === []) {
+            return false;
+        }
+
+        foreach ($guards as $guard) {
+            if (! is_array($guard)) {
+                continue;
+            }
+
+            $enabledConfig = $guard['enabled_config'] ?? null;
+            if (is_string($enabledConfig) && $enabledConfig !== '' && ! (bool) config($enabledConfig, false)) {
+                continue;
+            }
+
+            $boundAbstract = $guard['bound_abstract'] ?? null;
+            if (is_string($boundAbstract) && $boundAbstract !== '' && ! app()->bound($boundAbstract)) {
+                continue;
+            }
+
+            $contextMethod = $guard['context_not_null_method'] ?? null;
+            if (is_string($contextMethod) && $contextMethod !== '') {
+                if (! is_string($boundAbstract) || $boundAbstract === '') {
+                    continue;
+                }
+
+                try {
+                    $context = app($boundAbstract);
+                } catch (\Throwable) {
+                    continue;
+                }
+
+                if (! is_object($context) || ! method_exists($context, $contextMethod) || $context->{$contextMethod}() === null) {
+                    continue;
+                }
+            }
+
+            return true;
+        }
+
+        return false;
+    }
+
