+     *
+     * @return array{written: list<string>, skipped: list<string>}
+     */
+    public function warmPublicStaticBundles(): array
+    {
+        $version = $this->getCurrentVersion();
+        $dir = public_path('ext-static');
+        if (! is_dir($dir)) {
+            @mkdir($dir, 0o755, true);
+        }
+
+        $written = [];
+        $skipped = [];
+
+        foreach (['module' => 'modules', 'plugin' => 'plugins'] as $type => $publicPrefix) {
+            foreach (['js', 'css'] as $kind) {
+                $publicName = "{$publicPrefix}.bundle.{$kind}";
+                $publicPath = $dir.'/'.$publicName;
+                $sourcePath = $this->getBundleFilePath($type, $kind, $version);
+
+                if ($sourcePath === '' || ! is_file($sourcePath)) {
+                    if (@file_put_contents($publicPath, '') !== false) {
+                        $written[] = $publicName;
+                    } else {
+                        $skipped[] = $publicName;
+                    }
+
+                    continue;
+                }
+
+                $content = @file_get_contents($sourcePath);
+                if ($content === false) {
+                    $skipped[] = $publicName;
+
+                    continue;
+                }
+
+                $tmp = $publicPath.'.tmp.'.getmypid();
+                if (@file_put_contents($tmp, $content) === false) {
+                    $skipped[] = $publicName;
+
+                    continue;
+                }
+
+                if (! @rename($tmp, $publicPath)) {
+                    @unlink($tmp);
+                    $skipped[] = $publicName;
+
+                    continue;
+                }
+
+                $written[] = $publicName;
+            }
+        }
+
+        return ['written' => $written, 'skipped' => $skipped];
+    }
 }
