# 격리 phpunit 전용 업로드 ignore (deploy/cloudbuild-test.yaml + run-php-tests.sh).
#   - 운영 .gcloudignore 와 달리 tests/·phpunit.xml·.env.testing.example 을 "포함"한다(테스트 실행에 필수).
#   - 무거운/재생성 산출물(vendor, node_modules, _bundled, 캐시)은 동일하게 제외.
#   - 이 파일은 테스트 빌드 업로드에만 쓰이며 Cloud Run 운영 이미지와 무관하다.

.git
.gitignore
**/.git

# 문서 (테스트 불필요)
**/*.md

# 환경·비밀 — .env.testing.example 만 허용(스텝이 .env.testing 생성에 사용)
.env
.env.*
app/.env
app/.env.*
!app/.env.example
!app/.env.testing.example

# 재생성/무거운 산출물
app/vendor/
app/node_modules/
app/storage/**
app/bootstrap/cache/*
!app/bootstrap/cache/.gitignore
!app/bootstrap/cache/autoload-extensions.php

# _bundled = 개발·패키징 소스 미러
app/modules/_bundled/
app/templates/_bundled/
app/plugins/_bundled/
app/lang-packs/_bundled/

# 실험/레퍼런스 확장 (테스트 범위 밖)
app/modules/gnuboard7-hello_module/
app/plugins/gnuboard7-hello_plugin/
app/templates/gnuboard7-hello_admin_template/
app/templates/gnuboard7-hello_user_template/
app/templates/sirsoft-admin_basic/
app/templates/sirsoft-basic/

# node_modules / 프론트 캐시
**/node_modules/
**/.vite/
**/.turbo/
**/.cache/
**/coverage/
**/.nyc_output/
**/.eslintcache
*.tsbuildinfo

# 프론트 테스트 파일은 phpunit 과 무관 (업로드 축소)
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__/

# NOTE: app/tests/ · app/phpunit.xml · **/tests/ 는 의도적으로 포함(제외하지 않음) — phpunit 필수.

# 로컬 Docker / 에디터
docker-compose.override.yml
*.code-workspace
.vscode/
.cursor/

# 아카이브/대용량
**/unused/
app/storage/composer/
app/storage/app/extension_backups/
deploy/unused/backups/
app/vendor-bundle.zip
app/modules/**/vendor-bundle.zip

# 소스맵/설치기
**/*.map
app/docs/
app/public/install/
