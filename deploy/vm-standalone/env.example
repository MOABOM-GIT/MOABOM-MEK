# VM standalone env template — copy to /opt/moabom-app/app/.env
# SSOT: deploy/vm-standalone/MIGRATION-PLAN.md §2.1

APP_NAME=Moabom
APP_ENV=production
APP_DEBUG=false
APP_URL=https://moabom.com
APP_KEY=

INSTALLER_COMPLETED=true

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ── SaaS (와일드카드 멀티테넌트) ─────────────────────────────────────────────
MOABOM_SAAS_ENABLED=true
MOABOM_SAAS_BASE_DOMAIN=moabom.com
MOABOM_SAAS_PLATFORM_HOSTS=moabom.com,www.moabom.com,auth.moabom.com,apps.moabom.com
MOABOM_PLATFORM_DATABASE=moabom-platform
MOABOM_SAAS_MODULE_SETTINGS_BACKEND=db

# queue plane 사용 안 함 (Cloud Tasks / mobaom-queue 없음)
# MOABOM_QUEUE_PLANE_MODE=legacy
# MOABOM_RUNTIME_ROLE=web

# ── DB (VM 로컬 MySQL — compose 서비스명에 맞게 조정) ───────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_WRITE_HOST=127.0.0.1
DB_READ_HOST=127.0.0.1
DB_WRITE_DATABASE=moabom-db
DB_READ_DATABASE=moabom-db
DB_WRITE_USERNAME=moabom
DB_WRITE_PASSWORD=
DB_READ_USERNAME=moabom
DB_READ_PASSWORD=

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120

SESSION_DRIVER=cookie
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Storage (버킷 1개) ─────────────────────────────────────────────────────
FILESYSTEM_DISK=gcs
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
# VM SA attached 시 키 파일 없이 ADC 사용

# ── Reverb (브라우저 vs Laravel publish 분리 — 네트워크 병목 제거) ─────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=moabom-laravel
REVERB_APP_KEY=moabom-laravel-key
REVERB_APP_SECRET=

REVERB_HOST=realtime.moabom.com
REVERB_PORT=443
REVERB_SCHEME=https

REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6001
REVERB_SERVER_SCHEME=http

REVERB_SCALING_ENABLED=true

# ── 생성앱 (Phase 8+) ────────────────────────────────────────────────────
MOABOM_APPS_PREVIEW_ROUTING=dedicated_host
MOABOM_APPS_PREVIEW_STANDARD_HOST=apps.moabom.com
MOABOM_APPS_PREVIEW_HOSTED_APPS_DOMAIN=apps.moabom.com

# ── 소셜 OAuth broker (auth.moabom.com) ───────────────────────────────────
MOABOM_SOCIAL_AUTH_BROKER_HOST=auth.moabom.com
